# Copy to .env. First admin: create via MongoDB or one-time script. Passwords hashed on save.

MONGO_URI=mongodb+srv://user:password@cluster.example.com/dbname?retryWrites=true&w=majority
ACCESS_TOKEN_SECRET=your-access-token-secret-min-32-chars
ACCESS_TOKEN_EXPIRY=4d
REFRESH_TOKEN_SECRET=your-refresh-token-secret-min-32-chars
REFRESH_TOKEN_EXPIRY=30d

USE_MOCK_DATA=0
# When NODE_ENV=production, mock restaurant/menu data is never used regardless of this flag.

# Comma-separated list of allowed origins.
# Comma-separated. Include admin-web and any separate merchant-web deployment origins.
CORS_ORIGIN=https://your-admin.example.com,https://your-merchant-web.example.com

FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=your-firebase-service-account@project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Redis (required for background jobs -- BullMQ)
REDIS_URL=redis://127.0.0.1:6379

# Logging
LOG_LEVEL=info
NODE_ENV=production
