# Copy to keystore.properties (gitignored). Paths are relative to android/.
# Generate keystore: keytool -genkeypair -v -storetype PKCS12 -keystore release.keystore -alias upload -keyalg RSA -keysize 2048 -validity 10000
storeFile=release.keystore
storePassword=your_store_password
keyAlias=upload
keyPassword=your_key_password
