{
  "expo": {
    "name": "Xigoa",
    "slug": "xigoa",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/app-icons/pro/apple-devices/AppIcon.appiconset/icon-ios-1024x1024.png",
    "scheme": "xigoa",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./src/assets/app-icons/pro/apple-devices/AppIcon.appiconset/icon-ios-1024x1024.png",
      "resizeMode": "contain",
      "backgroundColor": "#ac1d17"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ritik.rideapp",
      "config": {
        "googleMapsApiKey": "AIzaSyCh1ybEuYu7ypDnz0JUrHHdVVDZPh8zJRs"
      }
    },
    "android": {
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyCh1ybEuYu7ypDnz0JUrHHdVVDZPh8zJRs"
        }
      },
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/app-icons/pro/android/mipmap-xxxhdpi/ic_launcher_foreground.png",
        "backgroundColor": "#ac1d17"
      },
      "package": "com.ritik.rideapp"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./src/assets/app-icons/pro/android/playstore-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow $(PRODUCT_NAME) to use your location."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow $(PRODUCT_NAME) to access your photos for ID verification."
        }
      ],
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
