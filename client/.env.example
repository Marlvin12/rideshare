# =============================================================================
# REQUIRED TO FIX 404 (sign-in / token check) when using Expo Go on a PHYSICAL
# DEVICE: phone and computer must be on the same Wi-Fi. Replace YOUR_MAC_IP
# with your computer's LAN IP (e.g. 192.168.1.5). Find it: macOS: run
#   ipconfig getifaddr en0
# in Terminal, or System Settings > Network > Wi-Fi > Details.
# =============================================================================
EXPO_PUBLIC_API_URL=http://YOUR_MAC_IP:3000
EXPO_PUBLIC_WS_URL=ws://YOUR_MAC_IP:3000

# Optional: only if you use Google Maps (directions, map tiles).
# EXPO_PUBLIC_MAP_API_KEY=your-google-maps-api-key

# Firebase (phone auth + email/password). Enable Phone + Email/Password in Firebase Console > Authentication > Sign-in method.
EXPO_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789
EXPO_PUBLIC_FIREBASE_APP_ID=1:123456789:web:abc123
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Optional: set to 1 to skip KYC flow for riders (testing only).
# EXPO_PUBLIC_SKIP_KYC=1

# Optional: restaurant partner app. Run server seed, then set one of the IDs.
# EXPO_PUBLIC_RESTAURANT_ID=641000000000000000000001
